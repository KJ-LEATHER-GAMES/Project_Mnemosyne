{
  "name": "m2-5-context-builder-draft",
  "version": "0.1.0-draft.3",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "context:build": "ts-node src/cli/context-build.ts",
    "registry:validate:project": "ts-node src/cli/project-registry-validate.ts",
    "registry:validate:agent": "ts-node src/cli/agent-registry-validate.ts",
    "registry:validate": "npm run registry:validate:project && npm run registry:validate:agent",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\" \"config/**/*.yaml\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"config/**/*.yaml\" \"*.md\"",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^20.17.0",
    "eslint": "^9.29.0",
    "prettier": "^3.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.34.0"
  }
}
